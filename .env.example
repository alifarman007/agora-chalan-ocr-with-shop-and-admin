# Copy to .env.local and fill in. NEVER commit .env.local.
# Names only here — no values, ever.

# ── Database ───────────────────────────────────────────────────────────────
# Runtime: Supabase transaction pooler, port 6543. Used with prepare:false.
DATABASE_URL=
# Migrations and pg_dump: Supabase session pooler, port 5432.
DATABASE_URL_MIGRATE=

# ── Auth ───────────────────────────────────────────────────────────────────
# At least 32 characters. Generate with: npx auth secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=

# ── Google Gemini (SERVER ONLY — never prefix with NEXT_PUBLIC_) ───────────
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# ── Storage ────────────────────────────────────────────────────────────────
# supabase | s3 | local
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=agora-documents
# Contains the project ref, so it lives only here, never in a committed file.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── Cron ───────────────────────────────────────────────────────────────────
CRON_SECRET=

# ── Optional: only when STORAGE_PROVIDER=s3 ────────────────────────────────
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
